#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -x "$project_root/.toolchains/flutter/bin/flutter" ]]; then
  echo "Local Flutter SDK not found. Install Flutter 3.50.0 or use flutter from PATH." >&2
  exit 1
fi
export FLUTTER_SUPPRESS_ANALYTICS=true
export XDG_CONFIG_HOME="$project_root/.toolchains/config"
export PUB_CACHE="$project_root/.pub-cache"
export GRADLE_USER_HOME="$project_root/.toolchains/gradle"
if [[ -x "$project_root/.toolchains/jdk21/bin/javac" ]]; then
  export JAVA_HOME="$project_root/.toolchains/jdk21"
fi
if [[ -d "$project_root/.toolchains/android-sdk" ]]; then
  export ANDROID_HOME="$project_root/.toolchains/android-sdk"
  export ANDROID_USER_HOME="$project_root/.toolchains/android-user"
fi
exec "$project_root/.toolchains/flutter/bin/flutter" --no-version-check "$@"
